#!/usr/bin/env php
<?php

/**
 * php vendor/luguohuakai/packme/packme
 * 快速打包项目代码 <br>
 * 运行于项目根目录 <br>
 * 首次运行会在当前目录下生成 dist/version.ini <br>
 * 主要是利用了git archive(归档)功能 <br>
 * 环境依赖: php>=7.4(phar 扩展)/git命令行, 运行时无第三方库依赖 <br>
 * @author DM <769245396@qq.com>
 */

// 工具版本, 发布时同步更新 CHANGELOG
const PACKME_VERSION = '1.1.1';

// 内置的项目名 -> 服务器绝对路径映射(srun 内部约定), 可用 packme.ini 的 object_path_map 覆盖或扩展
const PACKME_OBJECT_PATH_MAP = [
    'SRUN4-SELFSERVICE' => '/srun3/www/srun4-selfservice/',
    'SRUN4-API' => '/srun3/www/srun4-api/',
    'SRUN4-API-74' => '/srun3/www/srun4-api/',
    'SRUN4K-MANAGENT' => '/srun3/www/srun4-mgr/',
    'SRUN4-MGR' => '/srun3/www/srun4-mgr/',
    'SRUN4-SYSTEM' => '/srun3/www/srun4-system/',
    'SRUNDIY' => '/srun3/www/srunDIY/',
    'SRUN4-WEBCRON' => '/srun3/www/srun4-webcron/',
    'SRUN_LOGINWEB' => '/srun3/www/srun_loginweb/',
    'SRUN4-IDEVM' => '/srun3/www/srun4-idevm/',
    'SRUN4-IDEVM-SELFSERVICE' => '/srun3/www/srun4-idevm-selfservice/',
    'SRUN_DEVMGRT' => '/srun3/www/srun_devmgrt/',
    'SRUNLOGWEB' => '/srun3/www/srunlogweb/',
    'SRUNWEIXIN' => '/srun3/www/srunweixin/',
    'WEBAUTHN' => '/srun3/www/webauthn/',
    'WIFI_PORTAL' => '/srun3/www/wifi_portal/',
    'SRUN_SERVICE' => '/srun3/www/srun_service/',
    'SRUN4K-REPORT' => '/srun3/www/srun4k-report/',
    'SRUN4-BI-SERVER' => '/srun3/www/srun4-bi-server/',
    'MICRODRAW' => '/srun3/www/srun_mq/',
    'ZABBIXFROMGITHUB' => '/usr/share/zabbix/',
    'PACKME' => '/packme/',
];

// 命令行参数(不需要 autoload 也能用)
$cli_args = $_SERVER['argv'] ?? [];
if (in_array('--version', $cli_args, true)) {
    fwrite(STDOUT, 'packme ' . PACKME_VERSION . PHP_EOL);
    exit(0);
}
if (in_array('--help', $cli_args, true)) {
    packmeHelp();
    exit(0);
}

Func::logInfo('PACKME ' . PACKME_VERSION . ' POWERED BY LUGUOHUAKAI');
Func::logInfo();

// 准备所需文件====================================================================
$dist_dir = './dist';
if (!is_dir($dist_dir)) mkdir($dist_dir);
$version_file = './dist/version.ini';
if (!is_file($version_file)) file_put_contents($version_file, '');

// 初始化Git====================================================================
$git = new Git;
// 优先使用项目内已安装的 replaceme, 找不到时回退到本脚本所在目录(composer 包目录或 phar 内)
$replaceme = is_file('./vendor/luguohuakai/packme/replaceme') ? './vendor/luguohuakai/packme/replaceme' : __DIR__ . '/replaceme';
$replaceme5 = is_file('./vendor/luguohuakai/packme/replaceme5') ? './vendor/luguohuakai/packme/replaceme5' : __DIR__ . '/replaceme5';
// phar 内的路径无法交给 git/PharData 使用, 先释放为真实临时文件(保留原始文件名)
$replaceme = releaseBundledFile($replaceme);
$replaceme5 = releaseBundledFile($replaceme5);
if (is_file($replaceme)) $git->addFile($replaceme);
if (is_file($replaceme5)) $git->addFile($replaceme5);

// 生成文件默认替换位置绝对路径====================================================================
$object_name = strtoupper($git->objectName());
// : 自动判断当前项目根目录并生成replaceme.ini文件
$replaceme_ini_file = './replaceme.ini';
if (!is_file($replaceme_ini_file)) file_put_contents($replaceme_ini_file, 'object_root=/srun3/www/srun4-mgr/');
$replaceme_ini = new Ini($replaceme_ini_file);

// packme.ini 可选配置
$packme_ini = new Ini('./packme.ini');

// 语言: en(默认) / zh, 见 packme.ini 的 lang 配置
Lang::set((string)$packme_ini->get('lang', 'en'));

// 项目名 -> 服务器路径: 内置映射(srun 内部约定) + packme.ini 的 object_path_map 覆盖
$object_path_map = PACKME_OBJECT_PATH_MAP;
$custom_path_map = json_decode((string)$packme_ini->get('object_path_map'), true);
if (is_array($custom_path_map)) {
    foreach ($custom_path_map as $name => $path) {
        if (is_string($name) && is_string($path)) {
            $object_path_map[strtoupper($name)] = $path;
        }
    }
}
$object_path = $object_path_map[$object_name] ?? '';

if ($object_path) $replaceme_ini->set('object_root', $object_path);
if (is_file($replaceme_ini_file)) $git->addFile($replaceme_ini_file);

// 使用信息统计(可用 packme.ini 的 report_usage=0 或环境变量 PACKME_REPORT_USAGE=0 关闭)====================================================================
if ($packme_ini->get('report_usage') !== '0' && getenv('PACKME_REPORT_USAGE') !== '0') {
    reportUsage($object_name, $object_path);
}

// 选择打包方式====================================================================
// 打包方式 1:全量打包 2:最近一次提交和当前未提交的文件 3:某两次提交的差异文件 4:当前已修改但未提交的文件
Func::logInfo('Please select packaging method:');
Func::logInfo('      [1]: Full packaging');
Func::logInfo('      [2]: Pack the most recently commit and currently not commit files');
Func::logInfo('      [3]: Pack the difference files commit between two times');
Func::logInfo('      [4]: Pack files that have been modified but not yet commit');
Func::logInfo('      [5]: Pack the most recently commit files');
Func::logInfo('      [6]: Pack the last two commit files');
Func::logInfo('      [7]: Pack the specified one-time commit');
Func::logInfo('      [8]: Pack specified branch');
Func::logInfo('      [9]: Pack specified path');
Func::logPrimary('Your choice (default [5]):', false);
choice:
$choice = trim(fgets(STDIN));
if ($choice == '') $choice = 5;
$time = date('ymdHis');
$last_hash = strtoupper($git->hashShort());

// 具体打包操作====================================================================
switch ($choice) {
    case 2:
        $progress = new ProgressBar(100, "Packing last commit and current changes...");
        $file = "{$object_name}_LAST2NOW_{$time}_$last_hash.tar.gz";
        genVersion($version_file, $time, $git);
        $rs = $git->output($file)->newCommit('NOW')->oldCommit('HEAD~1')->setProgressBar($progress)->run();
        if ($rs === null) exit(1);
        Func::logInfo($rs);
        Func::logPrimary('Generated File: ' . $git->getOutPutFile());
        exit(0);
    case 5:
        $progress = new ProgressBar(100, "Packing last commit...");
        $file = "{$object_name}_LAST1COMMIT_{$time}_$last_hash.tar.gz";
        genVersion($version_file, $time, $git);
        $rs = $git->output($file)->newCommit('HEAD')->oldCommit('HEAD~1')->setProgressBar($progress)->run();
        if ($rs === null) exit(1);
        if ($rs) Func::logInfo($rs);
        Func::logPrimary('Generated File: ' . $git->getOutPutFile());
        exit(0);
    case 6:
        $progress = new ProgressBar(100, "Packing last two commits...");
        $file = "{$object_name}_LAST2COMMIT_{$time}_$last_hash.tar.gz";
        genVersion($version_file, $time, $git);
        $rs = $git->output($file)->newCommit('HEAD')->oldCommit('HEAD~2')->setProgressBar($progress)->run();
        if ($rs === null) exit(1);
        Func::logInfo($rs);
        Func::logPrimary('Generated File: ' . $git->getOutPutFile());
        exit(0);
    case 4:
        $progress = new ProgressBar(100, "Packing uncommitted changes...");
        $file = "{$object_name}_NOT_COMMIT_{$time}_$last_hash.tar.gz";
        genVersion($version_file, $time, $git);
        $rs = $git->output($file)->newCommit('NOW')->setProgressBar($progress)->run();
        if ($rs === null) exit(1);
        Func::logInfo($rs);
        Func::logPrimary('Generated File: ' . $git->getOutPutFile());
        exit(0);
    case 3:
        Func::logInfo('Please enter new commit id(<=) (default:HEAD):', false);
        $new = resolveCommitId(trim(fgets(STDIN)), 'HEAD');
        if ($new === '') exit(1);
        Func::logInfo('Please enter old commit id(>) (default:HEAD~1):', false);
        $old = resolveCommitId(trim(fgets(STDIN)), 'HEAD~1');
        if ($old === '') exit(1);
        $_new = strtoupper($new);
        $_old = strtoupper($old);
        $progress = new ProgressBar(100, "Packing changes between commits...");
        $file = "{$object_name}_2COMMIT_{$time}_{$_new}_$_old.tar.gz";
        genVersion($version_file, $time, $git);
        $rs = $git->output($file)->newCommit($new)->oldCommit($old)->setProgressBar($progress)->run();
        if ($rs === null) exit(1);
        Func::logInfo($rs);
        Func::logPrimary('Generated File: ' . $git->getOutPutFile());
        exit(0);
    case 7:
        Func::logInfo('Please enter the commit id:', false);
        $new = resolveCommitId(trim(fgets(STDIN)));
        if ($new === '') exit(1);
        $_new = strtoupper($new);
        $progress = new ProgressBar(100, "Packing specific commit...");
        $file = "{$object_name}_ONE_COMMIT_{$time}_$_new.tar.gz";
        genVersion($version_file, $time, $git);
        $rs = $git->output($file)->newCommit($new)->oldCommit($new . '~')->setProgressBar($progress)->run();
        if ($rs === null) exit(1);
        Func::logInfo($rs);
        Func::logPrimary('Generated File: ' . $git->getOutPutFile());
        exit(0);
    case 8:
        Func::logInfo('Please enter the branch name(default:current branch):', false);
        $branch = trim(fgets(STDIN));
        $rs = $git->branchCommitId($branch);
        if (empty($rs)) {
            Func::logError('Not found any commit');
            exit(1);
        }
        $new = $rs[0];
        $_new = strtoupper($new);
        $old = $rs[1];
        $_old = strtoupper($old);
        $progress = new ProgressBar(100, "Packing branch changes...");
        $file = "{$object_name}_BRANCH_{$time}_{$_new}_$_old.tar.gz";
        genVersion($version_file, $time, $git);
        $rs = $git->output($file)->newCommit($new)->oldCommit($old)->setProgressBar($progress)->run();
        if ($rs === null) exit(1);
        Func::logInfo($rs);
        Func::logPrimary('Generated File: ' . $git->getOutPutFile());
        exit(0);
    case 9: // 仅打包指定目录 不生成版本信息
        $file = "./dist/{$object_name}_PATH_$time.tar.gz";
        exit(packPath($file) ? 0 : 1);
    case 1:
        $version = genVersion($version_file, $time, $git);
        exit(fullPack($git, $object_name, $version, $version_file) ? 0 : 1);
    default:
        Func::logError('Your input is incorrect, please re-enter');
        goto choice;
}

