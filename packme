    public static function set(string $lang): void
    {
        $lang = strtolower(trim($lang));
        self::$lang = in_array($lang, ['zh', 'cn', 'zh-cn', 'zh_cn', 'chinese'], true) ? 'zh' : 'en';
    }

    public static function get(): string
    {
        return self::$lang;
    }

    /**
     * 翻译一条消息(未命中则原样返回)
     * @param string $msg
     * @return string
     */
    public static function translate(string $msg): string
    {
        if (self::$lang === 'en' || $msg === '') return $msg;
        if (isset(self::$messages[$msg])) return self::$messages[$msg];
        foreach (self::$prefixes as $en => $zh) {
            if (strpos($msg, $en) === 0) return $zh . substr($msg, strlen($en));
        }
        return $msg;
    }
}

/**
 * 命令行输出与字符串工具(内置实现, 不依赖第三方库)
 */
class Func
{
    public static function logInfo(string $msg = '', bool $wrap = true)
    {
        $msg = Lang::translate($msg);
        if ($wrap) $msg .= PHP_EOL;
        echo $msg;
    }

    public static function logPrimary(string $msg = '', bool $wrap = true)
    {
        $msg = Lang::translate($msg);
        $msg = "\033[34m $msg \033[0m";
        if ($wrap) $msg .= PHP_EOL;
        echo $msg;
    }

    public static function logWarn(string $msg = '', bool $wrap = true)
    {
        $msg = Lang::translate($msg);
        $msg = "\033[33m $msg \033[0m";
        if ($wrap) $msg .= PHP_EOL;
        echo $msg;
    }

    public static function logError(string $msg = '', bool $wrap = true)
    {
        $msg = Lang::translate($msg);
        $msg = "\033[41m $msg \033[0m";
        if ($wrap) $msg .= PHP_EOL;
        echo $msg;
    }

    public static function logSuccess(string $msg = '', bool $wrap = true)
    {
        $msg = Lang::translate($msg);
        $msg = "\033[32m $msg \033[0m";
        if ($wrap) $msg .= PHP_EOL;
        echo $msg;
    }

    /**
     * 检查字符串是否以指定字符串结尾(按字节比较, 对 UTF-8 同样正确)
     * @param string $haystack
     * @param string $needle
     * @return bool
     */
    public static function hasSuffix(string $haystack, string $needle): bool
    {
        if ($needle === '') return true;
        return substr($haystack, -strlen($needle)) === $needle;
    }

    /**
     * 检查字符串是否以指定字符串开头
     * @param string $haystack
     * @param string $needle
     * @return bool
     */
    public static function hasPrefix(string $haystack, string $needle): bool
    {
        return strncmp($haystack, $needle, strlen($needle)) === 0;
    }
}

class Ini
{
    private string $file;
    public array $all = [];

    public function __construct($file)
    {
        $this->file = $file;
        if (is_file($file)) {
            $rs = parse_ini_file($file);
            if ($rs !== false) $this->all = $rs;
        }
    }

    public function get($key, $default = null)
    {
        if (!is_file($this->file)) return $default;
        return $this->all[$key] ?? $default;
    }

    public function set($key, $value): bool
    {
        $data = array_merge($this->all, [$key => $value]);
        $result = !(file_put_contents($this->file, $this->arrayToIni($data)) === false);
        if ($result) $this->all = $data;
        return $result;
    }

    public function setAll($data): bool
    {
        $data = array_merge($this->all, $data);
        $result = !(file_put_contents($this->file, $this->arrayToIni($data)) === false);
        if ($result) $this->all = $data;
        return $result;
    }

    private function arrayToIni($data): string
    {
        if (empty($data)) return '';
        $str = '';
        foreach ($data as $key => $datum) {
            $str .= $key . '=' . $this->encodeValue($datum) . PHP_EOL;
        }
        return $str;
    }

    /**
     * 编码 ini 值: 含空格/特殊字符时加双引号, 避免 parse_ini_file 读回时出错
     * @param mixed $value
     * @return string
     */
    private function encodeValue($value): string
    {
        $value = (string)$value;
        if ($value !== '' && preg_match('/^[A-Za-z0-9_.\/:@\-]+$/', $value)) {
            return $value;
        }
        return '"' . str_replace(['\\', '"'], ['\\\\', '\\"'], $value) . '"';
    }
}

class Git
{
    private string $cmd_hash_short = 'git rev-list HEAD --abbrev-commit --max-count=1';
    private string $cmd_hash_long = 'git rev-parse HEAD';
    private string $cmd_branch_name = 'git symbolic-ref --short -q HEAD';
    private string $cmd_name = 'git rev-parse --show-toplevel';
    private string $cmd_remote_v = 'git remote -v';
    private string $cmd_user_name = 'git config user.name';

    private string $output = '';
    private array $add_file = [];
    private string $format = '';
    private string $branch = '';

    private string $new_commit = '';
    private string $old_commit = '';

    // 默认打包于当前目录下的dist目录内
    private string $dist = './dist/';

    /**
     * 说明文件应该先就存在于dist<br>
     * 打包前先往说明文件追加所有变更文件路径<br>
     * 如果说明文件存在则自动打包说明文件<br>
     * @var string
     */
    private string $change_file = './dist/changes.txt';
    private string $change_file_pro = './dist/changes_pro.txt';

    public string $cmd = '';
    private ?string $prepare_error = null;

    private ?ProgressBar $progressBar = null;

    public function setProgressBar(ProgressBar $progressBar): Git
    {
        $this->progressBar = $progressBar;
        return $this;
    }

    /**
     * @param string $output 输出文件名 如: update.tar.gz
     * @return $this
     */
    public function output(string $output): Git
    {
        $this->output = $output;
        $this->change_file_pro = $this->dist . $this->output . '.txt';
        return $this;
    }

    public function getOutPutFile(): string
    {
        return $this->dist . $this->output;
    }

    /**
     * 需要额外打包的文件 可添加多个
     * @param string $add_file 当前路径下的文件全路径 如: data/demo.sql
     * @return $this
     */
    public function addFile(string $add_file): Git
    {
        if (!in_array($add_file, $this->add_file, true)) {
            $this->add_file[] = $add_file;
        }
        return $this;
    }

    /**
     * 指定打包文件格式
     * 如果output已指定文件后缀这里可以不再指定
     * @param string $format 如: tar zip tar.gz
     * @return $this
     */
    public function format(string $format): Git
    {
        $this->format = $format;
        return $this;
    }

    /**
     * 指定最新的一次git提交的hash或HEAD(将包含)
     * @param $commit_id
     * @return $this
     */
    public function newCommit($commit_id): Git
    {
        $this->new_commit = $commit_id;
        return $this;
    }

    /**
     * 指定最之前一次git提交的hash或HEAD(将不包含)
     * @param $commit_id
     * @return $this
     */
    public function oldCommit($commit_id): Git
    {
        $this->old_commit = $commit_id;
        return $this;
    }

    /**
     * 全量打包时的分支名称
     * @param $branch_name
     * @return $this
     */
    public function branch($branch_name): Git
    {
        $this->branch = $branch_name;
        return $this;
    }

    public function prepare(): Git
    {
        // 先收集变更文件并生成说明文件，说明文件同样通过 --add-file 进入压缩包
        // $selector 是 git archive 的 tree-ish: NOW 模式是临时 tree 的 sha，其它模式是 commit id + 差异文件
        $selector = '';
        if ($this->new_commit) {
            if ($this->new_commit === 'NOW') {
                $selector = $this->prepareWorktree();
                if ($this->prepare_error !== null) return $this;
            } else {
                $pathspecs = $this->prepareDiff();
                if ($this->prepare_error !== null) return $this;
                $selector = trim(escapeshellarg($this->new_commit) . ' ' . $pathspecs);
            }
        }

        $this->cmd .= 'git archive ';
        if ($this->branch) $this->cmd .= escapeshellarg($this->branch) . ' ';
        if ($this->output) $this->cmd .= '-o ' . escapeshellarg($this->dist . $this->output) . ' ';
        if ($this->format) $this->cmd .= '--format=' . escapeshellarg($this->format) . ' ';
        foreach ($this->add_file as $item) {
            $this->cmd .= '--add-file=' . escapeshellarg($item) . ' ';
        }
        if ($selector !== '') $this->cmd .= "$selector ";
        $this->cmd = trim($this->cmd);
        return $this;
    }

    /**
     * NOW 模式(打包未提交的工作区变更)专用
     *
     * git archive 只能归档 commit/tree 的内容，直接 `git archive HEAD <pathspec>` 有两个问题：
     * 1. 归档出来的是 HEAD 里的旧内容，而不是工作区修改后的内容；
     * 2. 新增(已 git add)的文件不在 HEAD 中，作为 pathspec 会报
     *    fatal: pathspec 'xxx' did not match any files。
     * 因此这里先把变更文件写入临时索引，再用 git write-tree 得到临时 tree 进行归档。
     * 该过程只读取工作区，不会修改当前索引和 HEAD。
     * @return string 临时 tree 的 sha；失败时返回空字符串并设置 prepare_error
     */
    private function prepareWorktree(): string
    {
        $diff = $this->old_commit === 'HEAD~1'
            ? 'git diff --diff-filter=ACMR --name-only HEAD~1'
            : 'git diff --diff-filter=ACMR --name-only HEAD';

        $files = $this->changedFiles($diff);
        if ($this->prepare_error !== null) return '';
        if (empty($files)) {
            $this->prepare_error = 'No valid changed files found, packaging stopped';
            return '';
        }

        $this->writeChangeFile($diff);
        $this->warnUntrackedFiles();

        $files = $this->excludeAddedArchiveFiles($files);
        if (empty($files)) {
            $this->prepare_error = 'No valid changed files found, packaging stopped';
            return '';
        }

        $tree = $this->createTreeFromWorktree($files);
        return $tree ?? '';
    }

    /**
     * 打包某两次提交之间的差异文件
     * @return string 需要追加到 git archive 命令末尾的 pathspec 串
     */
    private function prepareDiff(): string
    {
        $diff = trim(sprintf('git diff --diff-filter=ACMR --name-only %s %s', escapeshellarg($this->old_commit), escapeshellarg($this->new_commit)));

        $files = $this->changedFiles($diff);
        if ($this->prepare_error !== null) return '';
        if (empty($files)) {
            $this->prepare_error = 'No valid changed files found, packaging stopped';
            return '';
        }

        $this->writeChangeFile($diff);

        $files = $this->excludeAddedArchiveFiles($files);
        if (empty($files)) {
            $this->prepare_error = 'No valid changed files found, packaging stopped';
            return '';
        }

        // 每个文件路径单独转义，避免特殊字符和中文编码问题
        $pathspecs = '';
        foreach ($files as $file) {
            $pathspecs .= escapeshellarg($file) . ' ';
        }
        return trim($pathspecs);
    }

    /**
     * 获取变更文件列表(已通过 --diff-filter 排除删除的文件)
     * @param string $diff 形如 git diff --diff-filter=ACMR --name-only xxx 的命令
     * @return array
     */
    private function changedFiles(string $diff): array
    {
        // 先获取变更文件列表，避免直接在命令中使用 $() 导致中文路径编码问题
        $output = [];
        $return_code = 0;
        // 设置环境变量确保正确处理中文路径
        // 注意：这需要系统支持 UTF-8 locale，如果系统不支持，可能需要用户配置 Git
        // 参考 README.md 中的说明：git config --global core.quotepath false
        $old_lc_all = getenv('LC_ALL');
        $old_lang = getenv('LANG');
        putenv('LC_ALL=en_US.UTF-8');
        putenv('LANG=en_US.UTF-8');
        exec("$diff 2>&1", $output, $return_code);
        // 恢复原始环境变量
        if ($old_lc_all !== false) {
            putenv('LC_ALL=' . $old_lc_all);
        } else {
            putenv('LC_ALL');
        }
        if ($old_lang !== false) {
            putenv('LANG=' . $old_lang);
        } else {
            putenv('LANG');
        }

        if ($return_code !== 0) {
            $this->prepare_error = 'Failed to get changed files';
            return [];
        }

        if (empty($output)) {
            $this->prepare_error = 'No changed files found, packaging stopped';
            return [];
        }

        $files = [];
        foreach ($output as $file) {
            $file = trim($file);
            if (empty($file)) continue;

            // 去除路径两端的引号（git diff 可能输出带引号的路径）
            $file = trim($file, '"\'');

            // 处理转义的八进制编码路径（如 \345\223\210\345\260\224 等）
            // 如果设置了 UTF-8 环境变量，git 会直接输出正确的中文路径
            // 如果没有设置，git 会输出转义的八进制编码，需要解码
            // 使用 preg_replace_callback 解码八进制转义序列
            // 如果路径不包含转义序列，则保持不变
            $decodedFile = preg_replace_callback('/\\\\([0-7]{3})/', function ($matches) {
                return chr(octdec($matches[1]));
            }, $file);

            if ($decodedFile === '') continue;

            if ($this->new_commit === 'NOW') {
                // 对于 NOW，只保留工作区真实存在的文件
                if (is_dir($decodedFile)) continue;
                if (is_file($decodedFile)) $files[] = $decodedFile;
            } else {
                // 对于特定 commit，检查文件是否存在于该 commit 中
                // git cat-file -e 的语法是 commit:path，需要将整个参数转义
                $commit_path = $this->new_commit . ':' . $decodedFile;
                $check_cmd = 'git cat-file -e ' . escapeshellarg($commit_path) . ' 2>' . $this->nullDevice();
                exec($check_cmd, $check_output, $check_code);
                if ($check_code === 0) $files[] = $decodedFile;
            }
        }
        return $files;
    }

    /**
     * 用工作区内容构造临时 tree(只影响临时索引文件，不修改当前索引与工作区)
     * @param array $files
     * @return string|null
     */
    private function createTreeFromWorktree(array $files): ?string
    {
        $tmpIndex = tempnam(sys_get_temp_dir(), 'packme_index_');
        if ($tmpIndex === false) {
            $this->prepare_error = 'Failed to create temporary git index';
            return null;
        }
        // git 需要一个不存在的路径来初始化索引，否则会认为索引已损坏
        @unlink($tmpIndex);

        $old_index = getenv('GIT_INDEX_FILE');
        putenv('GIT_INDEX_FILE=' . $tmpIndex);
        try {
            if ($this->execGit('git read-tree --empty') === null) {
                $this->prepare_error = 'Failed to init temporary git index';
                return null;
            }
            foreach ($files as $file) {
                if ($this->execGit('git add -- ' . escapeshellarg($file)) === null) {
                    $this->prepare_error = 'Failed to add file to temporary index: ' . $file;
                    return null;
                }
            }
            $tree = $this->execGit('git write-tree');
            if (!$tree) {
                $this->prepare_error = 'Failed to write temporary tree';
                return null;
            }
            return $tree;
        } finally {
            if ($old_index !== false) {
                putenv('GIT_INDEX_FILE=' . $old_index);
            } else {
                putenv('GIT_INDEX_FILE');
            }
            @unlink($tmpIndex);
        }
    }

    /**
     * 未跟踪(未 git add)的文件不会被自动打包，这里明确提示，避免被静默漏掉
     * @return void
     */
    private function warnUntrackedFiles(): void
    {
        $output = [];
        $code = 0;
        exec('git -c core.quotepath=false ls-files --others --exclude-standard 2>' . $this->nullDevice(), $output, $code);
        if ($code !== 0) return;

        $dist_prefix = $this->normalizePath($this->dist);
        $untracked = [];
        foreach ($output as $file) {
            $file = trim($file);
            if ($file === '') continue;
            $normalized = $this->normalizePath($file);
            // 打包产物目录、以及会通过 --add-file 进入压缩包的文件不算漏打
            if ($dist_prefix !== '' && ($normalized === $dist_prefix || strpos($normalized, $dist_prefix . '/') === 0)) continue;
            if ($this->isAddedArchiveFile($file)) continue;
            $untracked[] = $file;
        }

        if ($untracked) {
            Func::logWarn('The following untracked files will NOT be included, run git add first if needed:');
            foreach ($untracked as $file) {
                Func::logWarn('  ' . $file);
            }
        }
    }

    /**
     * 生成 changes.txt 以及与压缩包同名的说明文件，并把它们加入打包列表
     * @param string $diff
     * @return void
     */
    private function writeChangeFile(string $diff): void
    {
        $packme_ini = new Ini('./packme.ini');
        if ($packme_ini->get('generate_change_txt') !== '0') {
            $log = 'git log %s..%s --pretty=format:"%%B%%nChange Files" --name-only --no-merges';
            $this->clearChangeFile();
            if ($this->new_commit === 'NOW' && !$this->old_commit) {
                file_put_contents($this->change_file, PHP_EOL . 'Change Files:' . PHP_EOL, FILE_APPEND);
                shell_exec("$diff 2>&1 >> $this->change_file");
            } elseif ($this->new_commit === 'NOW' && $this->old_commit === 'HEAD~1') {
                shell_exec(sprintf($log, 'HEAD~1', 'HEAD') . " 2>&1 >> $this->change_file");
            } else {
                shell_exec(sprintf($log, $this->old_commit, $this->new_commit) . " 2>&1 >> $this->change_file");
            }
        }

        // 生成和压缩包同名的说明文件用以解释压缩包, 而不用打开压缩包查看changes.txt
        if (is_file($this->change_file)) {
            copy($this->change_file, $this->change_file_pro);
            $this->addFile($this->change_file);
        }
        if (is_file($this->change_file_pro)) {
            $this->addFile($this->change_file_pro);
        }
    }

    /**
     * 过滤掉已经通过 --add-file 进入压缩包的文件，避免同一个文件在压缩包里出现两次
     * @param array $files
     * @return array
     */
    private function excludeAddedArchiveFiles(array $files): array
    {
        $result = [];
        foreach ($files as $file) {
            if (!$this->isAddedArchiveFile($file)) $result[] = $file;
        }
        return $result;
    }

    /**
     * git archive --add-file 会把文件放到压缩包根目录，避免差异文件里再次加入同一个文件:
     * 1. 路径完全相同(如 dist/changes.txt、dist/version.ini)；
     * 2. 压缩包根目录下的同名文件(如 replaceme.ini)。
     * @param string $file
     * @return bool
     */
    private function isAddedArchiveFile(string $file): bool
    {
        $normalizedFile = $this->normalizePath($file);
        if ($normalizedFile === '') return false;

        foreach ($this->add_file as $addFile) {
            $normalizedAdd = $this->normalizePath($addFile);
            if ($normalizedAdd === '') continue;
            if ($normalizedAdd === $normalizedFile) return true;
            if (strpos($normalizedFile, '/') === false && basename($normalizedAdd) === $normalizedFile) {
                return true;
            }
        }

        return false;
    }

    private function normalizePath(string $file): string
    {
        $file = str_replace('\\', '/', trim($file));
        $file = preg_replace('#^(?:\./)+#', '', $file);
        return trim($file, '/');
    }

    /**
     * 清理历史记录
     * @return void
     */
    private function clearChangeFile()
    {
        if (!is_file($this->change_file)) {
            Func::logInfo('Generate file: ' . $this->change_file);
            file_put_contents($this->change_file, '');
        }
        $contents = file_get_contents($this->change_file);
        $separator = '====================';
        if ($contents) {
            Func::logInfo('Change file exists: ' . $this->change_file);
            $arr = explode($separator, $contents);
            file_put_contents($this->change_file, $arr[0] . $separator . PHP_EOL . PHP_EOL);
        } else {
            Func::logWarn('Change file contents is empty: ' . $this->change_file);
            if (is_file('./vendor/luguohuakai/packme/README.md')) {
                $readme = './vendor/luguohuakai/packme/README.md';
            } elseif (is_file('./README.md')) {
                // 测试时使用
                $readme = './README.md';
            } else {
                // phar 独立运行时使用内置 README
                $readme = __DIR__ . '/README.md';
            }
            if (is_file($readme)) {
                $separator2 = '## replaceme';
                $replaceme_doc = explode($separator2, file_get_contents($readme))[1];
                file_put_contents($this->change_file, $separator2 . $replaceme_doc . PHP_EOL . PHP_EOL);
            } else {
                Func::logWarn('Readme file not exists: ' . $readme);
            }
            file_put_contents($this->change_file, $separator . PHP_EOL . PHP_EOL, FILE_APPEND);
        }
    }

    public function run(): ?string
    {
        // 说明文件已在 prepare() 中生成并加入打包列表
        if (!$this->cmd) $this->prepare();
        if ($this->prepare_error !== null) {
            Func::logError($this->prepare_error);
            return null;
        }

        if (PHP_OS === 'WINNT' && !$this->branch) {
            $ps = $this->execGit('where powershell');
            if ($ps) {
                $this->cmd = "$ps $this->cmd";
            } else {
                Func::logError('Cmd temporarily does not support, Please execute manually in powershell');
                Func::logPrimary($this->cmd);
                return '';
            }
        }

        if (is_file($this->getOutPutFile())) unlink($this->getOutPutFile());

        // 执行命令并更新进度
        if ($this->progressBar) {
            $this->progressBar->setProgress(30);
            $result = $this->execGit($this->cmd);
            $this->progressBar->setProgress(100);
            return $result;
        }

        return $this->execGit($this->cmd);
    }

    public function hashShort(): string
    {
        return $this->execGit($this->cmd_hash_short);
    }

    public function hashLong(): string
    {
        return $this->execGit($this->cmd_hash_long);
    }

    public function branchName(): string
    {
        return $this->execGit($this->cmd_branch_name);
    }

    public function username(): string
    {
        return trim($this->execGit($this->cmd_user_name));
    }

    public function objectName(): string
    {
        $res = trim($this->execGit($this->cmd_remote_v));
        if ($res) {
            $arr1 = explode(PHP_EOL, $res);
            if (isset($arr1[0]) && Func::hasSuffix(trim($arr1[0]), ')')) {
                $str = substr(trim($arr1[0]), strrpos(trim($arr1[0]), '/') + 1, strrpos(trim($arr1[0]), '.') - strrpos(trim($arr1[0]), '/') - 1);
                if ($str) $object_name = $str;
            }
        }

        if (!isset($object_name)) {
            $rs = $this->execGit($this->cmd_name);
            $arr = explode('/', $rs);
            $object_name = $arr[count($arr) - 1];
        }

        return $object_name;
    }

    // 根据分支名称获取分支创建时的 commit 和最新的 commit
    public function branchCommitId($branch = '')
    {
        if (!$branch) $branch = $this->branchName();
        exec('git reflog show ' . escapeshellarg($branch), $output);
        if (!empty($output)) {
            $old = explode(' ', array_pop($output))[0];
            $new = explode(' ', array_shift($output))[0];
            return [$new, $old];
        } else {
            return false;
        }
    }

    /**
     * @param $cmd
     * @return string|null
     */
    public function execGit($cmd): ?string
    {
//        $rs = shell_exec("$cmd 2>&1");
        $last_line = exec($cmd, $output, $code);
        if ($code === 0) {
            if (count($output) === 1) return trim($last_line);
            if (count($output) === 0) return '';
            $str = '';
            foreach ($output as $item) {
                $str .= $item . PHP_EOL;
            }
            return trim($str);
        }
        return null;
    }

    private function nullDevice(): string
    {
        return strtoupper(substr(PHP_OS, 0, 3)) === 'WIN' ? 'nul' : '/dev/null';
    }
}

// 进度条类
class ProgressBar
{
    private $total;
    private int $current = 0;
    private float $startTime;
    private int $lastPercent = 0;
    private float $lastUpdateTime = 0;
    private float $updateInterval = 0.1; // 更新间隔(秒)
    private $message;

    public function __construct($total = 100, $message = '')
    {
        $this->total = $total;
        $this->message = Lang::translate((string)$message);
        $this->startTime = microtime(true);
    }

    public function setProgress($current)
    {
        $this->current = min($current, $this->total);
        $this->display();
    }

    public function setMessage($message)
    {
        $this->message = Lang::translate((string)$message);
        $this->display();
    }

    private function display()
    {
        $now = microtime(true);
        if ($now - $this->lastUpdateTime < $this->updateInterval) {
            return;
        }

        $percent = (int)floor(($this->current / $this->total) * 100);
        if ($percent == $this->lastPercent) {
            return;
        }

        $this->lastPercent = $percent;
        $this->lastUpdateTime = $now;

        $elapsed = $now - $this->startTime;
        $rate = $elapsed > 0 ? $this->current / $elapsed : 0;

        $half = (int)floor($percent / 2);
        $bar = str_repeat('=', $half);
        $empty = str_repeat(' ', 50 - $half);

        // 清除当前行并移动到行首
        echo "\r\033[K";

        // 显示进度条
        echo sprintf("%s\n[%s>%s] %d%% %s",
                $this->message,
                $bar,
                $empty,
                $percent,
                $this->formatSize($rate) . '/s'
        );

        // 移动光标到上一行
        echo "\033[1A";

        // 刷新输出
        flush();

        if ($this->current >= $this->total) {
            echo "\n\n";
        }
    }

    private function formatSize($bytes): string
    {
        $units = ['B', 'KB', 'MB', 'GB'];
        $bytes = max($bytes, 0);
        $pow = floor(($bytes ? log($bytes) : 0) / log(1024));
        $pow = min($pow, count($units) - 1);
        $bytes /= pow(1024, $pow);
        return round($bytes, 2) . ' ' . $units[$pow];
    }
}

