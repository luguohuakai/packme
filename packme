/**
 * 使用量上报(失败或超时都不应影响打包)
 * @param string $name
 * @param string $path
 * @return void
 */
function reportUsage(string $name, string $path): void
{
    $url = 'http://218.75.75.91:4845/packme/default/add';
    $payload = http_build_query(['name' => $name, 'path' => $path]);

    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => $payload,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_CONNECTTIMEOUT => 2,
            CURLOPT_TIMEOUT => 2,
        ]);
        @curl_exec($ch);
        return;
    }

    $context = stream_context_create(['http' => [
        'method' => 'POST',
        'header' => "Content-Type: application/x-www-form-urlencoded\r\n",
        'content' => $payload,
        'timeout' => 2,
    ]]);
    @file_get_contents($url, false, $context);
}

/**
 * 校验用户输入的 commit id, 支持直接回车取默认值
 * @param string $input
 * @param string $default
 * @return string 合法时返回原输入(或默认值), 否则返回空字符串
 */
function resolveCommitId(string $input, string $default = ''): string
{
    $input = trim($input);
    if ($input === '') $input = $default;
    if ($input === '') {
        Func::logError('commit id cannot be empty');
        return '';
    }

    $null = strtoupper(substr(PHP_OS, 0, 3)) === 'WIN' ? 'nul' : '/dev/null';
    $output = [];
    $code = 0;
    exec('git rev-parse --verify --quiet ' . escapeshellarg($input . '^{commit}') . ' 2>' . $null, $output, $code);
    if ($code !== 0) {
        Func::logError('commit id does not exist or is not a commit: ' . $input);
        return '';
    }
    return $input;
}

/**
 * phar 内的文件无法直接交给 git / PharData 使用, 释放为真实临时文件并返回路径。
 * 目录名带内容 hash 以便复用, 文件名保持原样( git archive --add-file 只取 basename )。
 * @param string $path
 * @return string 真实文件路径; 失败时返回空字符串
 */
function releaseBundledFile(string $path): string
{
    if ($path === '' || strpos($path, 'phar://') !== 0) return $path;

    $content = @file_get_contents($path);
    if ($content === false) return '';

    $dir = rtrim(sys_get_temp_dir(), '/\\') . DIRECTORY_SEPARATOR . 'packme_bundled_' . substr(md5($content), 0, 8);
    if (!is_dir($dir) && !@mkdir($dir, 0700, true) && !is_dir($dir)) return '';

    $target = $dir . DIRECTORY_SEPARATOR . basename($path);
    if (!is_file($target) || @file_get_contents($target) !== $content) {
        if (@file_put_contents($target, $content) === false) return '';
        @chmod($target, 0755);
    }
    return $target;
}

/**
 * 根据目录进行打包
 * @param string $file 生成的文件路径
 * @return bool
 */
function packPath(string $file): bool
{
    Func::logPrimary("If you have any instructions about this installation package, please write them in advance './dist/changes.txt'");
    input:
    Func::logInfo('Please enter the path to be packaged:', false);
    $path = trim(fgets(STDIN));
    if ($path == '') {
        Func::logError('Path cannot be empty');
        goto input;
    } else if (!is_dir($path) && !is_file($path)) {
        Func::logError('Path not exists');
        goto input;
    } else {
        $tar_file = str_replace('.gz', '', $file);
        @unlink($tar_file);
        try {
            $tar = new PharData($tar_file);
        } catch (Throwable $e) {
            Func::logError('Create tar failed: ' . $e->getMessage());
            return false;
        }

        try {
            $archivePath = getArchiveMemberPath($path);
            addToArchive($tar, $path, $archivePath);
            $dir = getArchiveDirectoryPrefix($path);

            // 指定项目根路径
            global $replaceme_ini;
            $replaceme_ini->set('object_root', '/srun3/www/');

            if (is_file('replaceme.ini')) addToArchive($tar, 'replaceme.ini', $dir . 'replaceme.ini');
            global $replaceme, $replaceme5;
            $r = str_replace('./', '', $replaceme);
            $r5 = str_replace('./', '', $replaceme5);
            if (is_file('replaceme')) addToArchive($tar, 'replaceme', $dir . 'replaceme');
            if (is_file($r)) addToArchive($tar, $r, $dir . 'replaceme');
            if (is_file('replaceme5')) addToArchive($tar, 'replaceme5', $dir . 'replaceme5');
            if (is_file($r5)) addToArchive($tar, $r5, $dir . 'replaceme5');
            if (is_file('dist/changes.txt')) {
                $filePath = getRelativeFilePathsInSpecifyDirectory($path);
                if ($filePath) {
                    $content = "\nChange Files\n";
                    $content .= implode("\n", $filePath);
                    file_put_contents('dist/changes.txt', $content, FILE_APPEND);
                }
                addToArchive($tar, 'dist/changes.txt', $dir . 'changes.txt');
            }
        } catch (Throwable $e) {
            Func::logError('Add files to tar failed: ' . $e->getMessage());
            unset($tar);
            @unlink($tar_file);
            return false;
        }

        // PharData 需要先释放对象, 写入才会真正落盘
        unset($tar);

        if (!gzipFile($tar_file, $file)) {
            Func::logError("Compress tar failed: $tar_file");
            @unlink($tar_file);
            return false;
        }
        @unlink($tar_file);

        Func::logPrimary('Generated File: ' . $file);
        return true;
    }
}

/**
 * 把本地文件或目录加入 tar 压缩包, dest 为目标路径(可为空前缀)
 * @param PharData $archive
 * @param string $local
 * @param string $dest
 * @return void
 */
function addToArchive(PharData $archive, string $local, string $dest = ''): void
{
    $local = rtrim($local, '/\\');
    if ($local === '') return;

    $dest = trim(str_replace('\\', '/', $dest), '/');
    if ($dest === '.') $dest = '';

    if (is_file($local)) {
        addArchiveFile($archive, $local, $dest === '' ? basename($local) : $dest);
        return;
    }
    if (!is_dir($local)) return;

    $prefix = $dest === '' ? '' : $dest . '/';
    $baseLen = strlen($local) + 1;
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($local, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );
    foreach ($iterator as $item) {
        $relative = str_replace('\\', '/', substr($item->getPathname(), $baseLen));
        $target = $prefix . $relative;
        if ($item->isDir()) {
            if (!isset($archive[$target])) $archive->addEmptyDir($target);
        } else {
            addArchiveFile($archive, $item->getPathname(), $target);
        }
    }
}

/**
 * 加入单个文件, 目标已存在时保留先加入的内容(避免重复条目导致 PharData 抛异常)
 * @param PharData $archive
 * @param string $local
 * @param string $target
 * @return void
 */
function addArchiveFile(PharData $archive, string $local, string $target): void
{
    if ($target === '' || isset($archive[$target])) return;
    $archive->addFile($local, $target);
}

/**
 * 获取打包路径在压缩包中的目标路径
 * @param string $path
 * @return string
 */
function getArchiveMemberPath(string $path): string
{
    $normalizedPath = str_replace('\\', '/', trim($path));
    // 去掉 Windows 盘符(如 D:/xxx)，避免 tar 成员名里出现冒号
    $normalizedPath = preg_replace('#^[A-Za-z]:#', '', $normalizedPath);
    $normalizedPath = rtrim($normalizedPath, '/');
    $normalizedPath = preg_replace('#^(?:\./)+#', '', $normalizedPath);
    // 绝对路径只保留相对部分，保证压缩包内的路径可跨平台解压
    return trim($normalizedPath, '/');
}

/**
 * 获取打包目录在压缩包中的前缀
 * @param string $path
 * @return string
 */
function getArchiveDirectoryPrefix(string $path): string
{
    $archivePath = getArchiveMemberPath($path);
    if ($archivePath === '' || $archivePath === '.') return '';

    $prefix = is_file($path) ? dirname($archivePath) : $archivePath;
    if ($prefix === '' || $prefix === '.') return '';

    return $prefix . '/';
}

/**
 * 写一个获取指定目录结构并返回数组的方法
 * @param string $path
 * @return array
 */
function getRelativeFilePathsInSpecifyDirectory(string $path): array
{
    $targetPath = realpath($path);
    if ($targetPath === false) return [];

    if (is_file($targetPath)) {
        return [basename($targetPath)];
    }

    // 初始化存储相对路径的数组
    $relativePaths = [];

    // 遍历指定目录及其子目录
    $objects = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($targetPath, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::SELF_FIRST,
            RecursiveIteratorIterator::CATCH_GET_CHILD // Ignore "Permission denied"
    );

    foreach ($objects as $name => $object) {
        if ($object->isFile()) {
            // 计算相对于指定目录的相对路径
            $relativePath = substr($name, strlen($targetPath) + 1);
            $relativePaths[] = $relativePath;
        }
    }

    return $relativePaths;
}

/**
 * 流式压缩 tar 文件为 tar.gz，避免把整个归档读入内存
 * @param string $source
 * @param string $destination
 * @return bool
 */
function gzipFile(string $source, string $destination): bool
{
    $in = fopen($source, 'rb');
    if ($in === false) return false;

    $out = gzopen($destination, 'wb9');
    if ($out === false) {
        fclose($in);
        return false;
    }

    while (!feof($in)) {
        $chunk = fread($in, 1024 * 1024);
        if ($chunk === false) {
            fclose($in);
            gzclose($out);
            @unlink($destination);
            return false;
        }
        if (gzwrite($out, $chunk) === false) {
            fclose($in);
            gzclose($out);
            @unlink($destination);
            return false;
        }
    }

    fclose($in);
    gzclose($out);
    return true;
}

/**
 * 全量打包
 * @param Git $git
 * @param $object_name
 * @param $version
 * @param $version_file
 * @return bool
 */
function fullPack(Git $git, $object_name, $version, $version_file): bool
{
    Func::logPrimary('Packing vendor? (It will take a long time for y) (y/n) (default:n): ', false);
    $answer = trim(fgets(STDIN));
    Func::logInfo("Begin packing...");

    if ($answer == 'y') {
        $progress = new ProgressBar(100, "Packing main files...");

        // 打包主要文件
        $rs = $git->branch($git->branchName())->output("$object_name.{$version['version']}.tar")->setProgressBar($progress)->run();
        if ($rs !== null) {
            $progress->setProgress(40);
            Func::logInfo($rs);
        } else {
            Func::logError('command exec failed: ' . $git->cmd);
            return false;
        }

        $pack_file = $git->getOutPutFile();

        // 打包 vendor
        $progress->setMessage("Packing vendor files...");
        try {
            $archive = new PharData($pack_file);
            addToArchive($archive, 'vendor', 'vendor');
            unset($archive);
        } catch (Throwable $e) {
            Func::logError('Packing vendor failed: ' . $e->getMessage());
            return false;
        }
        $progress->setProgress(70);

        // 压缩文件
        $progress->setMessage("Compressing files...");
        $new_pack_file = $pack_file . '.gz';
        if (!gzipFile($pack_file, $new_pack_file)) {
            Func::logError("Compress tar failed: $pack_file");
            return false;
        }
        unlink($pack_file);
        $progress->setProgress(100);

        Func::logInfo("Packing vendor finished");
    } else {
        $progress = new ProgressBar(100, "Packing files...");

        $rs = $git->branch($git->branchName())->output("$object_name.{$version['version']}.tar.gz")->setProgressBar($progress)->run();
        if ($rs !== null) {
            $progress->setProgress(100);
            Func::logInfo($rs);
        } else {
            Func::logError('command exec failed: ' . $git->cmd);
            return false;
        }
        $new_pack_file = $git->getOutPutFile();
    }

    Func::logInfo("Packing finished");
    Func::logPrimary('Generated File: ' . $new_pack_file);
    return true;
}

/**
 * 生成版本信息
 * @param $version_file
 * @param $time
 * @param Git $git
 * @return array
 */
function genVersion($version_file, $time, Git $git): array
{
    $ini = new Ini($version_file);
    if ($ini->get('version')) {
        $arr = explode('.', $ini->get('version'));
        $vv = "$arr[0].$arr[1].";
    } else {
        $vv = 'V1.0.';
    }
    // 注意: 如需更改主次版本 如: V1.0 -> V2.1 需打包前手动更改./dist/version.ini中version字段的主次版本
    $version = [
            'author' => $git->username(),
            'version' => $vv . $time . '.' . strtoupper($git->hashShort()),
            'git_branch_name' => $git->branchName(),
            'git_version_hash_short' => $git->hashShort(),
            'git_version_hash_long' => $git->hashLong(),
            'update_time' => date('Y-m-d H:i:s'),
    ];
    Func::logInfo('Generate version...');
    Func::logInfo("Branch: {$version['git_branch_name']}");
    Func::logPrimary("Version: {$version['version']}");
    if ($ini->setAll($version)) {
        $git->addFile($version_file);
        Func::logInfo("Update version succeed");
    } else {
        Func::logWarn("Update version failed!");
    }

    return $version;
}
